# Server/database
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
JWT_SECRET=replace-with-a-long-random-secret
PORT=3000

# AI (optional; AI routes return a clear 503 when not configured)
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-2.5-flash

# Supabase Storage (required for paper uploads in Vercel production)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=paper-files

# Only needed when the API is hosted on a different origin than the frontend
CORS_ORIGIN=https://<your-vercel-domain>.vercel.app
